APP_NAME=Vouch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://vouch.test

# SEO and social-sharing metadata. Set these to your production domain before deploy.
SEO_TITLE="Vouch — Secure Document Signing"
SEO_DESCRIPTION="Send, sign, track, and protect important agreements with Vouch."
# SEO_IMAGE_URL=https://app.example.com/social-share.png
# SEO_TWITTER_SITE=@yourhandle

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Public legal-page contacts
VOUCH_SUPPORT_EMAIL=support@pensuh.com
VOUCH_PRIVACY_EMAIL=support@pensuh.com
VOUCH_SECURITY_EMAIL=support@pensuh.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (payment fields)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS invitations & SMS 2FA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Tetranyble-managed Vouch document storage
STORAGE_DISK=local
STORAGE_ROUTES_ENABLED=false
STORAGE_UPLOAD_MAX_SIZE=52428800
# Do not trust arbitrary proxy headers in production. Set known proxy IPs only.
TRUSTED_PROXIES=
